<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsTitle">



        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/text_size_title</item>
    </style>


    <style name="SettingsItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_item_height</item>
        <item name="android:background">@color/white</item>
    </style>


    <style name="SettingsText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textSize">@dimen/text_size_settings</item>

    </style>
</resources>