<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name= "MainMenuButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <!--размеры-->
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:padding">@dimen/icon_padding</item>
        
        <!--текст-->
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textColor">@color/black</item>

        <!--фон и другое-->
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/corner_radius</item>

        <!--icon-->
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">@color/black</item>

    </style>
    <style name="SettingsTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>

        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:layout_marginStart">@dimen/settings_title_margin_start</item>
        <item name="android:layout_marginTop">@dimen/settings_title_margin_top</item>
    </style>


    <style name="SettingsItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_item_height</item>
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>


    <style name="SettingsText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">match_parent</item>

        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">@dimen/text_size_settings</item>
        <item name="android:paddingStart">@dimen/padding_default</item>
        <item name="android:paddingEnd">@dimen/padding_default</item>
        <item name="android:layout_marginTop">@dimen/settings_text_margin_top</item>
        <item name="android:layout_marginStart">@dimen/settings_text_margin_start</item>
    </style>
    
    <style name="SettingsIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_marginTop">@dimen/settings_icon_margin_top</item>
        <item name="android:layout_marginEnd">@dimen/padding_default</item>
        <item name="android:tint">@color/gray</item>
    </style>
    <style name="SettingsSwitch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/settings_icon_margin_top</item>
        <item name="android:layout_marginEnd">@dimen/padding_default</item>
        <item name="android:thumbTint">@color/switch_thumb</item>
        <item name="android:trackTint">@color/switch_track</item>
    </style>

    <style name="SearchEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:hint">@string/search</item>
        <item name="android:maxLines">1</item>
        <item name="android:inputType">text</item>
        <item name="android:paddingStart">50dp</item>
        <item name="android:paddingEnd">@dimen/search_edit_text_padding_end</item>

        <item name="android:paddingTop">@dimen/search_edit_text_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/search_edit_text_padding_vertical</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">@color/search_hint_text_color</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:maxLength">50</item>
        <item name="android:background">@drawable/search_edit_text_background</item>



    </style>

    <style name="BackButtonIcon">
        <item name="android:layout_width">@dimen/search_icon_size</item>
        <item name="android:layout_height">@dimen/search_icon_size</item>
        <item name="android:layout_marginTop">@dimen/back_button_margin_top</item>
        <item name="android:layout_marginStart">@dimen/back_button_margin_start</item>
        <item name="android:layout_marginEnd">@dimen/search_icon_margin_end</item>
        <item name="android:tint">?attr/colorOnSurface</item>
    </style>

</resources>