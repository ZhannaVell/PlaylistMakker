<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp">

    <item android:gravity="center">
        <bitmap android:src="@drawable/ic_support_ears" />
    </item>

    <item
        android:gravity="center"
        android:left="2dp"
        android:top="2dp">
        <bitmap android:src="@drawable/ic_support_hair" />
    </item>

    <item
        android:gravity="center"
        android:left="4dp"
        android:top="4dp">
        <bitmap android:src="@drawable/ic_support_eyes" />
    </item>

    <item
        android:gravity="center"
        android:left="6dp"
        android:top="6dp">
        <bitmap android:src="@drawable/ic_support_left_eyes" />
    </item>

</layer-list>