<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/main_background_color"
    android:paddingStart="@dimen/padding_default"
    android:paddingEnd="@dimen/padding_default"
    android:paddingTop="10dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_title"
        android:layout_marginBottom="@dimen/margin_bottom_title"
        android:fontFamily="@font/ys_display_medium"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">


        <Button
            android:id="@+id/btn_search"
            style="@style/MainMenuButtonStyle"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_between_buttons"
            android:text="@string/search"
            app:icon="@drawable/ic_search_24"/>

        <Button
            android:id="@+id/btn_media"
            style="@style/MainMenuButtonStyle"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_between_buttons"
            android:text="@string/media"
            app:icon="@drawable/ic_media_24"/>

        <Button
            android:id="@+id/btn_settings"
            style="@style/MainMenuButtonStyle"
            android:layout_weight="1"
            android:text="@string/settings"
            app:icon="@drawable/ic_settings_24"/>

    </LinearLayout>

</LinearLayout>